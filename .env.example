# SMART SCHOOL AI
# Скопируйте этот файл в .env.local (фронт) и в переменные Railway (бэкенд).
# Никогда не публикуйте ключи и не коммитьте .env.local.

# --- Vercel (фронтенд) ---
API_URL=
NEXT_PUBLIC_SITE_URL=

# --- Railway (бэкенд) ---
PORT=8080
FRONTEND_URL=
DATABASE_URL=

# --- AI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite
